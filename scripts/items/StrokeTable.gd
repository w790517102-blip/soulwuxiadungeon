## 整個名稱的筆劃比較：逐字比筆劃，前面都一樣再比字數；仍相同回傳 0
static func compare(a: String, b: String) -> int:
	var n := mini(a.length(), b.length())
	for i in n:
		var sa := of(a[i])
		var sb := of(b[i])
		if sa != sb:
			return -1 if sa < sb else 1
	if a.length() != b.length():
		return -1 if a.length() < b.length() else 1
	return 0
